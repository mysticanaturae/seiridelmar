 10px; }

.searchandfilter.horizontal ul > li li { display: block; }

.ll-skin-melon td .ui-state-default { background: 0px 0px; border-width: me=
dium; border-style: none; border-color: currentcolor; border-image: none; t=
ext-align: center; padding: 0.3em; margin: 0px; font-weight: 400; color: rg=
b(108, 136, 172); font-size: 14px; }

